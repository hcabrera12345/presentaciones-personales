# Copiar a .env para desarrollo local. NUNCA subir .env al repositorio.
ENTORNO=desarrollo
AUTH_DESACTIVADA=true          # solo local: entra sin login como admin

# Supabase (Project Settings → Database / API)
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=           # dejar vacío si el proyecto usa claves de firma (JWKS)

# IA y transcripción
ANTHROPIC_API_KEY=             # clave "desarrollo" de la consola de Anthropic
CLAUDE_MODELO=claude-opus-5-5
GROQ_API_KEY=

# YouTube
PROXY_YOUTUBE=                 # vacío en local: el internet de casa no está bloqueado
CANAL_YOUTUBE_ID=              # UC… de Asuntos Centrales

# Meta (semana 3)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_TOKEN=
